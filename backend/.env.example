# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py
HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret-key

# MySQL Database Configuration
# Option A: Provide individual connection fields
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wastesmart_db
DB_USER=wastesmart_user
DB_PASSWORD=replace-with-your-mysql-password

# Option B: Or provide a full SQLAlchemy URI (overrides DB_* above if set)
# DATABASE_URL=mysql+pymysql://wastesmart_user:replace-with-your-mysql-password@127.0.0.1:3306/wastesmart_db?charset=utf8mb4

# Strict CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# JWT Authentication Settings
JWT_SECRET_KEY=replace-with-a-separate-strong-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Municipal Administrator Account (used by: flask init-admin)
# These values are ONLY read server-side. Never expose them through API responses.
# Run `flask init-admin` after first deploy to provision the admin account.
ADMIN_EMAIL=admin@wastesmart.com
ADMIN_PASSWORD=WasteSmart@Admin2026
ADMIN_NAME=Municipal Administrator
# ADMIN_PHONE=
# ADMIN_WARD=Central Municipal Operations

# Separate AI Sidecar Service (localhost-only, Option B)
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TIMEOUT_SECONDS=30
